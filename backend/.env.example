# Copy to .env and fill in. Never commit .env.
# Any OpenAI-compatible endpoint works (e.g. a MiniMax gateway).
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional: seconds before an LLM request is abandoned.
# LLM_TIMEOUT_SECONDS=120
# Optional: total attempts per LLM call (1-5), and the linear backoff between them.
# LLM_MAX_ATTEMPTS=2
# LLM_RETRY_BACKOFF_SECONDS=1
# Optional: most LLM requests in flight at once for this process (1-8); keeps VPS load predictable.
# LLM_MAX_CONCURRENCY=2

# Optional sandbox limits. One execution at a time, conservative for a small VPS.
# SANDBOX_PYTHON_IMAGE=python:3.12-slim
# SANDBOX_CPP_IMAGE=gcc:13
# SANDBOX_TIMEOUT_SECONDS=30
# SANDBOX_CPU_LIMIT=1.0
# SANDBOX_MEMORY_MB=512
# SANDBOX_PIDS_LIMIT=64
# SANDBOX_SCRATCH_MB=64
# SANDBOX_MAX_OUTPUT_BYTES=64000
# SANDBOX_MAX_CONCURRENCY=1

# Optional run lifecycle limits. One full agent run at a time; extra runs wait in a
# bounded queue, and POST /runs returns 429 once it is full.
# RUN_MAX_ACTIVE_RUNS=1
# RUN_MAX_QUEUED_RUNS=10
# RUN_MAX_RETAINED_RUNS=100
# Stops a whole run (every step together) after this many seconds, 30-3600.
# RUN_TIMEOUT_SECONDS=300
# Stops a run waiting for human approval after this many seconds, 5-86400. Counted from when
# approval is requested; separate from RUN_TIMEOUT_SECONDS, which counts active work only.
# APPROVAL_TIMEOUT_SECONDS=600

# Optional: where run records and graph checkpoints are stored (two SQLite files plus their
# -wal/-shm files). Must persist across restarts; defaults to backend/data. A relative path
# is relative to the working directory, so prefer an absolute one. Docker Compose mounts a
# named volume at /app/data.
# DATA_DIR=/var/lib/astraai

# Optional, Develop only: a read-only token for private repositories (fine-grained, with
# Contents: read on the repositories you choose). Public repositories need none. Sent to
# api.github.com only; never to the sandbox, the model, run state or logs.
# GITHUB_TOKEN=
# Optional: the Develop sandbox image (Python 3.12 + pinned pytest); build it from
# backend/sandbox as the README shows.
# SANDBOX_DEVELOP_IMAGE=astraai-sandbox-python:3.12.14-pytest9.1.1
